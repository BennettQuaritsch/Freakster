SPOTIFY_CLIENT_ID=your_spotify_app_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_app_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/spotify/callback
# Must match the iOS app's redirect URL exactly. Used by /api/spotify/ios/swap.
SPOTIFY_IOS_REDIRECT_URI=freakster://spotify-auth-callback
